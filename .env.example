# ---------------------------------------------------------------------------
# Copy to `.env` for local development. Every value here has a working default,
# so an empty .env still runs — this file documents what you can change.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=true

# SQLite locally; Render injects a PostgreSQL URL in production.
DATABASE_URL=sqlite+aiosqlite:///./civic.db

# Must be a private value of 32+ bytes in production (enforced at startup).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-in-production

# Browser origins allowed to call the API (comma-separated).
# In production this must include your Vercel URL or the frontend gets CORS errors.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bootstrap administrator, created on first startup.
ADMIN_EMAIL=admin@civic.gov
ADMIN_PASSWORD=admin123
ADMIN_NAME=Municipal Administrator

# OPTIONAL — leave blank to run entirely on the free local ML models.
# Setting it enables Claude-written dispatch summaries and the natural-language
# assistant. Everything else works identically without it.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# Seed ~180 demo complaints on first boot so the dashboard has data to show.
SEED_DEMO_DATA=true
SEED_COMPLAINT_COUNT=180
