# ---------------------------------------------------------------------------
# Copy to `.env` for local development. Every value here has a working default,
# so an empty .env still runs — this file documents what you can change.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=true

# SQLite locally; any hosted PostgreSQL URL in production.
#
# Paste the provider's connection string verbatim — the app rewrites the scheme to
# the async driver and translates libpq-only parameters. All of these work as-is:
#   Neon    postgresql://user:pw@ep-xxx.us-east-2.aws.neon.tech/civic?sslmode=require&channel_binding=require
#   Render  postgres://user:pw@dpg-xxx-a.oregon-postgres.render.com/civic
#   Local   postgresql://postgres:postgres@localhost:5432/civic
DATABASE_URL=sqlite+aiosqlite:///./civic.db

# Must be a private value of 32+ bytes in production (enforced at startup).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-in-production

# Browser origins allowed to call the API (comma-separated).
# In production this must include your Vercel URL or the frontend gets CORS errors.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bootstrap administrator, created on first startup.
ADMIN_EMAIL=admin@civic.gov
ADMIN_PASSWORD=admin123
ADMIN_NAME=Municipal Administrator

# ---------------------------------------------------------------------------
# LANGUAGE MODEL — entirely OPTIONAL.
#
# With no key at all the app is fully functional: the local scikit-learn models
# handle classification, priority, routing, summaries and duplicate detection at
# zero cost. A language model only improves the dispatch summary and enables the
# natural-language assistant.
#
# Set whichever key you have. If both, LLM_PROVIDER decides ("auto" prefers
# Anthropic, because its strict tool schema cannot return an invalid label).
#   auto | anthropic | deepseek | none
# ---------------------------------------------------------------------------
LLM_PROVIDER=auto

# Option A — DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Option B — Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Option C — any other OpenAI-compatible endpoint (Groq, Together, OpenRouter,
# a local vLLM/Ollama server). These override the DeepSeek values when set.
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPATIBLE_MODEL=llama-3.3-70b-versatile

# Verify whichever you chose:  python -m app.check_llm

# Seed ~180 demo complaints on first boot so the dashboard has data to show.
SEED_DEMO_DATA=true
SEED_COMPLAINT_COUNT=180
